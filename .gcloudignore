# Files never uploaded by `gcloud builds submit` (mirrors .dockerignore; private material stays local).
.gcloudignore
.git
.gitignore
**/.venv
**/node_modules
**/__pycache__
**/*.db
**/*.db-*
**/.env
**/.env.*
!**/.env.example
private-staging
artifacts
backups
*.dump
*.sql
!rights/sql/**/*.sql
web/dist
.pytest_cache
.ruff_cache
**/*.egg-info
.claude
/docs/
scripts/planning_contracts.py
scripts/spec_models.py
scripts/verify_spec.py
tests/test_planning_execution.py
tests/test_spec_contracts.py

# Terraform working files: state (it can hold keys), saved plans, settings and backend configuration. Releases
# build from `git archive`, but a hand-run build or upload from this tree must not carry them either.
**/.terraform/
**/*.tfstate*
**/*.plan
**/*.tfvars
**/backend.hcl
