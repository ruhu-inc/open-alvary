# Copy to deployment/.env, fill every value, chmod 600; never commit it.
PUBLIC_DOMAIN=open.alvary.ai
PUBLIC_REPOSITORY_URL=https://github.com/ruhu-ai/open-alvary
PUBLIC_MAINTAINER="Ruhu AI"
PUBLIC_CONTACT_EMAIL=ijidai@ruhu.ai
# Original catalogue metadata only; see DATA-LICENSE.md.
METADATA_LICENCE=CC-BY-4.0
# Generate 64 hexadecimal characters: openssl rand -hex 32
POSTGRES_PASSWORD=
# Encrypted backups to Cloudflare R2 (deployment/backup.sh), run daily by the host scheduler.
# Create a dedicated bucket and an R2 API token scoped to that bucket only (Object Read & Write).
BACKUP_REMOTE=r2:open-alvary-backups/production
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# PUBLIC key from scripts/backup_keygen.sh; the private key never touches the server.
BACKUP_RECIPIENT_FILE=
# Owner-delegated best practice (2026-10-07): 7 daily + 4 weekly restore points.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Failure alerts open a GitHub issue, which emails the maintainer. Fine-grained token with
# Issues: write on this repository only.
BACKUP_ALERT_COMMAND=/opt/open-alvary/alert_github_issue.sh
GITHUB_ALERT_TOKEN=
GITHUB_ALERT_REPOSITORY=ruhu-ai/open-alvary
# Independent denial journal: separate PostgreSQL on a different provider/host (journal_writer role).
ALVARY_JOURNAL_DATABASE_URL=
# Point-in-time recovery (deployment/pitr.yaml): pgBackRest WAL archive in a separate R2 bucket.
PITR_BUCKET=open-alvary-pitr
PITR_ENDPOINT_HOST=
PITR_ACCESS_KEY_ID=
PITR_SECRET_ACCESS_KEY=
# Generate with: openssl rand -base64 48 (store a copy in the password manager; restores need it)
PITR_CIPHER_PASS=
PITR_RETENTION_FULL=4
