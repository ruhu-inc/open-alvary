# Copy to deployment/.env, fill every value, chmod 600; never commit it.
PUBLIC_DOMAIN=open.alvary.ai
PUBLIC_REPOSITORY_URL=https://github.com/ruhu-ai/open-alvary
PUBLIC_MAINTAINER=Ruhu AI
PUBLIC_CONTACT_EMAIL=ijidai@ruhu.ai
# Original catalogue metadata only; see DATA-LICENSE.md.
METADATA_LICENCE=CC-BY-4.0
# Generate 64 hexadecimal characters: openssl rand -hex 32
POSTGRES_PASSWORD=
# Encrypted backups (deployment/backup.sh). Operator decisions; no defaults are supplied.
# BACKUP_DESTINATION: mounted directory on separate, off-host storage.
# BACKUP_RECIPIENT_FILE: PUBLIC OpenPGP key; the private key is held off the backup host.
# BACKUP_KEEP_DAILY / BACKUP_KEEP_WEEKLY: approved retention counts.
# BACKUP_ALERT_COMMAND: runs inside the backup container with "backup-failed <stage>".
BACKUP_DESTINATION=
BACKUP_RECIPIENT_FILE=
BACKUP_KEEP_DAILY=
BACKUP_KEEP_WEEKLY=
BACKUP_ALERT_COMMAND=
