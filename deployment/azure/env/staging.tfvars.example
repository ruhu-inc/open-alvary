# Copy to staging.tfvars (ignored by git) and fill in. Apply with deployment/azure/README.md.
subscription_id      = "<ruhu-sub subscription id>"
environment          = "staging"
location             = "swedencentral"
operator_email       = "hello@ruhu.ai"
operator_ip_ranges   = ["<your address>/32"]
monthly_budget       = 1200
public_domain        = "staging.open.alvary.ai"
api_domain           = "api.staging.open.alvary.ai"
admin_ssh_public_key = "ssh-ed25519 AAAA… operator"

# true only once both domains point at Front Door (README, phase 6): the availability test, and the
# worker's and daily job's schedules, start then.
domain_live = false

public_settings = {
  PUBLIC_REPOSITORY_URL = "https://github.com/ruhu-inc/open-alvary"
  PUBLIC_MAINTAINER     = "Ruhu, Inc."
  PUBLIC_CONTACT_EMAIL  = "hello@ruhu.ai"
  METADATA_LICENCE      = "CC-BY-4.0"
}

# Set by release.sh after the first build; the apps and jobs are created only once it is set.
public_image = ""

# Activation B, with the Auth0 tenant the console uses today.
accounts_enabled  = false
auth0_domain      = ""
console_client_id = ""

# A standby until the 1 December decision (MAC-12a): no Vespa machine and no GPU; the service searches
# in PostgreSQL. Both on before staging takes the public domains, the GPU once Azure grants quota (the
# A10 slice, Standard_NV6ads_A10_v5, is offered in Spain Central only).
engine_enabled    = false
inference_enabled = false

# Empty until a generation passes its gates (RSV-12): the service runs on the lexical arms.
vector_profile = ""

# Phase 4: the workbench, reading its collections from the corpus account (az://<account>/workbench/…).
# workbench_image  = ""
# workbench_domain = "review.open.alvary.ai"
# workbench_settings = {
#   ALVARY_REVIEW_OIDC_CLIENT_ID = "<the workbench's sign-in client ID>"
# }  # the collections default to the corpus account's copies (workbench.tf)
