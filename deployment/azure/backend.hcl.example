# Copy to backend.hcl (ignored by git), from deployment/azure/bootstrap's output, then in env/:
#   terraform init -backend-config=../backend.hcl -backend-config="key=staging.tfstate"
resource_group_name  = "<state resource group>"
storage_account_name = "<state storage account>"
container_name       = "open-alvary"
use_azuread_auth     = true
