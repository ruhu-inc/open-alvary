#cloud-config
# The embedder takes inputs of up to 8,192 tokens (retrieval.vectors.MAX_INPUT_TOKENS): the server would
# otherwise warm up on one input of the model's full 32,768, which needs more memory than a T4 holds.
# --auto-truncate is what lets the server take a limit below the model's own; nothing reaches it, as
# Open Alvary never sends an input that could be longer (retrieval.vectors.fitted).
# The reranker's own limit is 8,192 tokens; it warms up on one such input, not on the server's default
# batch of two, so the two models fit on a T4 side by side. Its inputs (a question and a passage of at
# most 2,000 characters each, retrieval.rerank) are far shorter, and one longer is refused, never cut.
# The inference machine: Docker with NVIDIA's container toolkit, and the two models as services. Each
# waits for the GPU driver (in the boot image), then serves on the private address only. As
# deployment/azure/env/inference-cloud-init.yaml.tftpl, but Docker and the toolkit are installed only
# where the image lacks them (a Deep Learning VM image may carry both), and packages are refreshed,
# not upgraded: a kernel or driver upgrade under a running GPU leaves it unusable until a reboot, so a
# new boot image replaces the machine instead.
package_update: true
package_upgrade: false
packages: [curl, gnupg]

write_files:
%{ for name, spec in { embedder = { model = embedder.model, revision = embedder.revision, port = 8080, args = "--max-batch-tokens 8192 --auto-truncate" }, reranker = { model = reranker.model, revision = reranker.revision, port = 8081, args = "--max-batch-tokens 8192" } } ~}
  - path: /etc/systemd/system/${name}.service
    content: |
      [Unit]
      Description=Open Alvary ${name} (${spec.model})
      After=docker.service
      Requires=docker.service
      [Service]
      ExecStartPre=/usr/bin/nvidia-smi
      ExecStartPre=-/usr/bin/docker rm -f ${name}
      ExecStart=/usr/bin/docker run --rm --name ${name} --gpus all \
        -p ${ip}:${spec.port}:80 -v /var/models:/data ${image} \
        --model-id ${spec.model} --revision ${spec.revision} ${spec.args}
      ExecStop=/usr/bin/docker stop -t 30 ${name}
      Restart=always
      RestartSec=30
      [Install]
      WantedBy=multi-user.target
%{ endfor ~}

runcmd:
  - [sh, -c, "command -v docker >/dev/null || (apt-get update && apt-get install -y docker.io)"]
  - [sh, -c, "command -v nvidia-ctk >/dev/null || curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | gpg --dearmor --yes -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg"]
  - [sh, -c, "command -v nvidia-ctk >/dev/null || curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list | sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' > /etc/apt/sources.list.d/nvidia-container-toolkit.list"]
  - [sh, -c, "command -v nvidia-ctk >/dev/null || (apt-get update && apt-get install -y nvidia-container-toolkit)"]
  - [nvidia-ctk, runtime, configure, --runtime=docker]
  - [systemctl, restart, docker]
  - [mkdir, -p, /var/models]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, embedder.service, reranker.service]
