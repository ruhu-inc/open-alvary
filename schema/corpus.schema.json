    "LanguageRule": {
      "additionalProperties": false,
      "description": "The work's own rule for divergence between its language versions (LNG-03), from its reviewed\nrecord: ``stated``, with the rule as stated, the language whose version prevails when it names one,\nwhere it is stated and the evidence; ``not_stated``, the reviewed copy states none;\n``not_applicable``, as the reviewer recorded.",
      "properties": {
        "status": {
          "enum": [
            "stated",
            "not_stated",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "prevails": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prevails"
        },
        "provision": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
