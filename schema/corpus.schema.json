    "Amendment": {
      "additionalProperties": false,
      "description": "A link between two works, from the asserting (later) one to the one it concerns (EDT-01).",
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,159}$",
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,159}$",
          "title": "Source Id",
          "type": "string"
        },
        "target_source_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,159}$",
          "title": "Target Source Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "amends",
            "repeals",
            "supersedes",
            "made_under",
            "cross_reference",
            "commences",
            "transposes",
            "domesticates",
            "implements",
            "ratifies",
            "cites"
          ],
          "title": "Kind",
          "type": "string"
        },
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "evidence_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Evidence Url",
          "type": "string"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source_id",
        "target_source_id",
        "kind",
        "evidence_url"
      ],
      "title": "Amendment",
      "type": "object"
    },
