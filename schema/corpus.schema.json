        "evidence_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Evidence Url",
          "type": "string"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source_id",
        "target_source_id",
        "kind",
        "evidence_url"
      ],
      "title": "Amendment",
      "type": "object"
    },
