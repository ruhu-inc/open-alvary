{
  "$defs": {
    "AcquisitionCommand": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "collection_id": {
          "pattern": "^scp_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Collection Id",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "reason": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "action": {
          "const": "record_acquisition_assessment",
          "title": "Action",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/AcquisitionInput"
        }
      },
      "required": [
        "command_id",
        "collection_id",
        "expected_revision",
        "reason",
        "action",
        "payload"
      ],
      "title": "AcquisitionCommand",
      "type": "object"
    },
    "AcquisitionInput": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "state": {
          "default": "draft",
          "enum": [
            "draft",
            "approved",
            "revoked"
          ],
          "title": "State",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "discover": {
          "default": "unknown",
          "enum": [
            "allow",
            "deny",
            "unknown"
          ],
          "title": "Discover",
          "type": "string"
        },
        "acquire": {
          "default": "unknown",
          "enum": [
            "allow",
            "deny",
            "unknown"
          ],
          "title": "Acquire",
          "type": "string"
        },
        "retain": {
          "default": "unknown",
          "enum": [
            "allow",
            "deny",
            "unknown"
          ],
          "title": "Retain",
          "type": "string"
        },
        "derive": {
          "default": "unknown",
          "enum": [
            "allow",
            "deny",
            "unknown"
          ],
          "title": "Derive",
          "type": "string"
        },
        "privacy_class": {
          "enum": [
            "no_personal_data",
            "personal_data",
            "unknown"
          ],
          "title": "Privacy Class",
          "type": "string"
        },
        "classification_reason": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Classification Reason",
          "type": "string"
        },
        "privacy_review_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Privacy Review Id"
        },
        "privacy_review_revision": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Privacy Review Revision"
        },
        "purpose": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "retention_deadline": {
          "format": "date-time",
          "title": "Retention Deadline",
          "type": "string"
        },
        "artifact_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Hash"
        }
      },
      "required": [
        "evidence_id",
        "valid_from",
        "expires_at",
        "id",
        "privacy_class",
        "classification_reason",
        "purpose",
        "retention_deadline"
      ],
      "title": "AcquisitionInput",
      "type": "object"
    },
    "CommandResult": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "anyOf": [
            {
              "format": "uuid",
