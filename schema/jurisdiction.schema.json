          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "event": {
          "enum": [
            "introduced",
            "first_reading",
            "second_reading",
            "committee_stage",
            "third_reading",
            "passed",
            "concurred",
            "certified",
            "presented_for_assent",
            "assented",
            "withheld_assent",
            "promulgated",
            "signed",
            "made",
            "laid",
            "approved",
            "adopted",
            "published",
            "commenced",
            "amended",
            "repealed",
            "expired",
            "suspended",
            "annulled",
            "struck_down",
            "lapsed",
            "withdrawn",
            "referendum",
            "filed",
            "heard",
            "reserved",
            "decided",
            "delivered",
            "corrected",
            "reported",
            "opened_for_signature",
            "ratified",
            "acceded",
            "entered_into_force",
            "denounced",
            "domesticated",
            "issued"
