        "signed_by": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signed By"
        }
      },
      "required": [
        "id",
        "label",
        "event"
      ],
      "title": "Step",
      "type": "object"
    }
