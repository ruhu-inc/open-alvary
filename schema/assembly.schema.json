        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "canonical_text": {
          "title": "Canonical Text",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/CanonicalPayload"
        }
      },
      "required": [
        "proposal_id",
        "snapshot_id",
        "snapshot_revision",
        "snapshot_hash",
        "serialization_profile_id",
        "profile_hash",
        "content_hash",
        "canonical_text",
        "payload"
      ],
      "title": "CanonicalView",
      "type": "object"
    },
