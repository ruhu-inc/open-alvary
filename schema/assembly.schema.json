    "Normalization": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "source_bytes": {
          "title": "Source Bytes",
          "type": "integer"
        },
        "normalized_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Normalized Hash",
          "type": "string"
        },
        "normalized_bytes": {
          "title": "Normalized Bytes",
          "type": "integer"
        },
        "operations": {
          "items": {
