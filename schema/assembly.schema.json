{
  "$defs": {
    "AssemblyReconcileCommand": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "collection_id": {
          "pattern": "^scp_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Collection Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "action": {
          "const": "reconcile_assembly",
          "title": "Action",
          "type": "string"
        },
        "after": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "limit": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "erase_due": {
          "default": false,
          "title": "Erase Due",
          "type": "boolean"
        }
      },
      "required": [
        "command_id",
        "collection_id",
        "reason",
        "action"
      ],
      "title": "AssemblyReconcileCommand",
      "type": "object"
    },
    "AssemblyResult": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Command Id"
        },
        "status": {
          "enum": [
            "applied",
            "forbidden",
            "conflict",
            "validation_failed",
            "capacity_exceeded",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "replayed": {
          "default": false,
          "title": "Replayed",
          "type": "boolean"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "source_order_mismatch",
                "canonical_byte_limit",
                "candidate_reuse_or_type",
                "body_content_missing",
                "duplicate_local_id",
                "table_grid_limit",
                "duplicate_cell_candidate",
                "cell_shape_missing",
                "cell_out_of_bounds",
                "cell_shape_mismatch",
                "candidate_in_multiple_cells",
                "cell_overlap",
                "unavailable_cell_conflict",
                "table_coverage_or_headers",
                "nested_or_duplicate_notice",
                "footnote_definitions",
                "footnote_order",
                "marker_scope_or_target",
                "marker_overlap",
                "marker_bounds",
                "marker_utf8_boundary",
                "marker_normalization_boundary",
                "footnote_content_missing",
                "exclusion_reason_missing",
                "repeated_header_mismatch",
                "furniture_target_forbidden",
                "candidate_coverage_or_order",
                "canonical_metadata_limit",
                "serializer_mismatch",
                "database_structure_invalid"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "object_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "output_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "scanned": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Scanned",
          "type": "integer"
        },
        "held": {
          "default": 0,
          "maximum": 12800,
          "minimum": 0,
          "title": "Held",
          "type": "integer"
        },
        "erasure_required": {
          "default": 0,
          "maximum": 12800,
          "minimum": 0,
          "title": "Erasure Required",
          "type": "integer"
        },
        "erased": {
          "default": 0,
          "maximum": 12800,
          "minimum": 0,
          "title": "Erased",
          "type": "integer"
        },
        "next_after": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next After"
        }
      },
      "required": [
        "command_id",
        "status"
      ],
      "title": "AssemblyResult",
      "type": "object"
    },
    "CandidateInput": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "adapter_local_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:_-]+$",
          "title": "Adapter Local Id",
          "type": "string"
        },
        "region_key": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:_-]+$",
          "title": "Region Key",
          "type": "string"
        },
        "parent_local_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9:_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Local Id"
        },
        "artifact_class": {
          "enum": [
            "native_text",
            "ocr_transcription"
          ],
          "title": "Artifact Class",
          "type": "string"
        },
        "block_type": {
          "enum": [
            "heading",
            "paragraph",
            "list_item",
            "table_cell",
            "footnote"
          ],
          "title": "Block Type",
          "type": "string"
        },
        "text": {
          "maxLength": 8192,
          "title": "Text",
          "type": "string"
        },
        "content_state": {
          "default": "present",
          "enum": [
            "present",
            "empty",
            "illegible",
            "unsupported"
          ],
          "title": "Content State",
          "type": "string"
        },
        "content_reason": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Reason"
        },
        "unavailable_page_reason": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Unavailable Page Reason",
          "type": "string"
        },
        "unavailable_geometry_reason": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Unavailable Geometry Reason",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9:_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "direction": {
          "default": "unknown",
          "enum": [
            "ltr",
            "rtl",
            "unknown"
          ],
          "title": "Direction",
          "type": "string"
        },
        "quality_state": {
          "const": "unassessed",
          "default": "unassessed",
          "title": "Quality State",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Warnings",
          "type": "array"
        },
        "cell": {
          "anyOf": [
            {
              "$ref": "#/$defs/CellProposal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "adapter_local_id",
        "region_key",
        "artifact_class",
        "block_type",
        "text",
        "unavailable_page_reason",
        "unavailable_geometry_reason"
      ],
      "title": "CandidateInput",
      "type": "object"
    },
    "CandidatePage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CandidateView"
          },
          "title": "Items",
          "type": "array"
        },
        "next_after": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next After"
        }
      },
      "title": "CandidatePage",
      "type": "object"
    },
    "CandidateSpan": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "integer"
        },
        "span_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Span Hash",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "start",
        "end",
        "span_hash"
      ],
      "title": "CandidateSpan",
      "type": "object"
    },
    "CandidateView": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "collection_id": {
          "pattern": "^scp_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Collection Id",
          "type": "string"
        },
        "assessment_id": {
          "format": "uuid",
          "title": "Assessment Id",
          "type": "string"
        },
        "assessment_revision": {
          "title": "Assessment Revision",
          "type": "integer"
        },
        "artifact_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Artifact Hash",
          "type": "string"
        },
        "purpose": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "retention_deadline": {
          "format": "date-time",
          "title": "Retention Deadline",
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Hash",
          "type": "string"
        },
        "text_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Hash",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/CandidateInput"
        }
      },
      "required": [
        "run_id",
        "artifact_id",
        "collection_id",
        "assessment_id",
        "assessment_revision",
        "artifact_hash",
        "purpose",
        "retention_deadline",
        "payload_hash",
        "text_hash",
        "payload"
      ],
      "title": "CandidateView",
      "type": "object"
    },
    "CanonicalCommand": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "collection_id": {
          "pattern": "^scp_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Collection Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "action": {
          "const": "record_canonical_proposal",
          "title": "Action",
          "type": "string"
        },
        "proposal_id": {
          "format": "uuid",
          "title": "Proposal Id",
          "type": "string"
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        },
        "snapshot_revision": {
          "maximum": 32,
          "minimum": 1,
          "title": "Snapshot Revision",
          "type": "integer"
        },
        "snapshot_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "purpose": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "serialization_profile_id": {
          "const": "OA-text-1",
          "default": "OA-text-1",
          "title": "Serialization Profile Id",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/CanonicalPlan"
        }
      },
      "required": [
        "command_id",
        "collection_id",
        "reason",
        "action",
        "proposal_id",
        "snapshot_id",
        "snapshot_revision",
        "snapshot_hash",
        "purpose",
        "plan"
      ],
      "title": "CanonicalCommand",
      "type": "object"
    },
    "CanonicalPayload": {
      "additionalProperties": false,
      "properties": {
        "plan": {
          "$ref": "#/$defs/CanonicalPlan"
        },
        "projection": {
          "$ref": "#/$defs/ProjectionDetails"
        }
      },
      "required": [
        "plan",
        "projection"
      ],
      "title": "CanonicalPayload",
      "type": "object"
    },
    "CanonicalPlan": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "notice": "#/$defs/NoticeBlock",
                "table": "#/$defs/TableBlock",
                "text": "#/$defs/TextBlock"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextBlock"
              },
              {
                "$ref": "#/$defs/TableBlock"
              },
              {
                "$ref": "#/$defs/NoticeBlock"
              }
            ]
          },
          "maxItems": 50,
          "title": "Blocks",
          "type": "array"
        },
        "footnotes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FootnoteDefinition"
          },
          "maxItems": 50,
          "title": "Footnotes",
          "type": "array"
        },
        "markers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FootnoteMarker"
          },
          "maxItems": 100,
          "title": "Markers",
          "type": "array"
        },
        "exclusions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Exclusion"
          },
          "maxItems": 50,
          "title": "Exclusions",
          "type": "array"
        }
      },
      "title": "CanonicalPlan",
      "type": "object"
    },
