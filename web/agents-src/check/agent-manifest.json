{
  "brand": "Open Alvary law check",
  "theme": {
    "primary": "#1a1a1a"
  },
  "networks": [
    {
      "name": "law_check",
      "front_man": "law_check",
      "hocon": "./law_check.network.json",
      "description": "Finds candidate legal sections and exact published wording in Open Alvary's catalogue for plain legal claims.",
      "tags": [
        "agentified-website"
      ],
      "sample_queries": [
        "Find the section and exact wording in the Freedom of Information Act 2011 about who can apply for information."
      ]
    }
  ],
  "llm_router": {
    "base_url": "https://api.otari.ai/api/v1",
    "mock": false,
    "byok_router": "https://api.otari.ai/api/v1"
  },
  "allowed_peers": [
    "https://open.alvary.ai"
  ],
  "peer_policy": {
    "mode": "closed",
    "deny_origins": []
  },
  "agent_mcp": {
    "protocol": "openalvary-agent-mcp/v1",
    "network": "law_check",
    "front_man": "law_check",
    "available": false,
    "reason": "The data tools are at https://open.alvary.ai/agents/mcp"
  },
  "linking": {
    "protocol": "openalvary-link/v1",
    "exports": [
      {
        "network": "law_check",
        "front_man": "law_check",
        "aliases": [
          "law_check"
        ],
        "url": "law_check"
      }
    ],
    "imports": [],
    "link_updates": {
      "mode": "browser-local"
    }
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": false,
    "direct_byok": true,
    "direct_mcp_requires_cors": true,
    "public_mcp_facade": false
  }
}
