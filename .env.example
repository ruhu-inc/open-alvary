# Optional: SQLite is the default for a lightweight local preview.
DATABASE_URL=postgresql+psycopg://open_alvary:local-development-only@localhost:5432/open_alvary

# Document AI Layout Parser (operator-only first-collection reading; pip install -e '.[ingestion]').
# Credentials come from Google Application Default Credentials, never from this file.
ALVARY_DOCAI_PROJECT=
ALVARY_DOCAI_LOCATION=eu
ALVARY_DOCAI_PROCESSOR_ID=
