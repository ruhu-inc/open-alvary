# Optional: SQLite is the default for a lightweight local preview.
DATABASE_URL=postgresql+psycopg://open_alvary:local-development-only@localhost:5432/open_alvary

# Document AI Layout Parser (operator-only first-collection reading; pip install -e '.[ingestion]').
# Credentials come from Google Application Default Credentials, never from this file.
ALVARY_DOCAI_PROJECT=
ALVARY_DOCAI_LOCATION=eu
ALVARY_DOCAI_PROCESSOR_ID=
ALVARY_DOCAI_PROCESSOR_VERSION=

# Batch reading pipeline (python -m ingestion.batch). Values belong in .env, never here.
ALVARY_BATCH_MAX_BILLED_PAGES=500
ALVARY_DOCAI_PAGES_PER_REQUEST=2
ALVARY_DOCAI_WORKERS=8
ALVARY_MINERU_KIT=
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# Review workbench (python -m workbench.admin; uvicorn workbench.app:app). Values belong in .env.
ALVARY_REVIEW_DATABASE_URL=
ALVARY_REVIEW_BASE_URL=
ALVARY_REVIEW_ALLOWED_HOSTS=
ALVARY_REVIEW_OIDC_ISSUER=https://accounts.google.com
ALVARY_REVIEW_OIDC_CLIENT_ID=
ALVARY_REVIEW_OIDC_CLIENT_SECRET=
# Local trial only: sign in by operator email without a password, answered on loopback only.
ALVARY_REVIEW_DEV_LOGIN=
