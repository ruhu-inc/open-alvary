{
  "name": "a withdrawal purges at once",
  "covers": [
    "A withdrawal in the feed purges every cached unit and pack citing that version at once.",
    "With Open Alvary out of reach afterwards, nothing citing the withdrawn version is served."
  ],
  "start": "2026-10-19T09:00:00+00:00",
  "steps": [
    {
      "do": "sync",
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/changes",
            "params": {
              "start": "now"
            }
          },
          "response": {
            "status": 200,
            "body": "$changes_start"
          }
        }
      ]
    },
    {
      "do": "retrieve",
      "query": "when must a controller report a breach",
      "filters": {
        "jurisdiction": "ng"
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/retrieve",
            "params": {
              "q": "when must a controller report a breach",
              "jurisdiction": "ng"
            }
          },
          "response": {
            "status": 200,
            "body": "$pack_breach",
            "headers": {
              "ETag": "W/\"pack-breach-1\""
            }
          }
        }
      ],
      "expect": {
        "answer": {
          "from_cache": false,
          "checked": true
        }
      }
    },
    {
      "do": "sync",
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/changes",
            "params": {
              "resume_token": "r1.start"
            }
          },
          "response": {
            "status": 200,
            "body": "$changes_withdrawal"
          }
        }
      ]
    },
    {
      "do": "retrieve",
      "query": "when must a controller report a breach",
      "filters": {
        "jurisdiction": "ng"
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/retrieve",
            "params": {
              "q": "when must a controller report a breach"
            }
          },
          "response": {
            "error": "connect"
          },
          "repeat": 3
        }
      ],
      "expect": {
        "raises": "Unavailable"
      }
    },
    {
      "do": "retrieve",
      "query": "when must a controller report a breach",
      "filters": {
        "jurisdiction": "ng"
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/retrieve",
            "params": {
              "q": "when must a controller report a breach"
            }
          },
          "response": {
            "status": 200,
            "body": "$pack_breach_after_withdrawal"
          }
        }
      ],
      "expect": {
        "answer": {
          "from_cache": false,
          "checked": true,
          "evidence": [
            "anc-sdr-1-r12"
          ]
        }
      }
    }
  ]
}
