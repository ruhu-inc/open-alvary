{
  "name": "out of reach, the cache answers labelled",
  "covers": [
    "A network error, a 5xx or a timeout on every attempt means Open Alvary is out of reach.",
    "Then the cached pack answers, every cited unit labelled currentness_not_checked with the time it was cached, and the answer is never presented as checked.",
    "A request with nothing cached, and a check, are not answered from the cache."
  ],
  "start": "2026-10-19T09:00:00+00:00",
  "steps": [
    {
      "do": "sync",
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/changes",
            "params": {
              "start": "now"
            }
          },
          "response": {
            "status": 200,
            "body": "$changes_start"
          }
        }
      ]
    },
    {
      "do": "retrieve",
      "query": "when must a controller report a breach",
      "filters": {
        "jurisdiction": "ng"
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/retrieve",
            "params": {
              "q": "when must a controller report a breach",
              "jurisdiction": "ng"
            }
          },
          "response": {
            "status": 200,
            "body": "$pack_breach",
            "headers": {
              "ETag": "W/\"pack-breach-1\""
            }
          }
        }
      ],
      "expect": {
        "answer": {
          "from_cache": false,
          "checked": true
        }
      }
    },
    {
      "do": "advance",
      "seconds": 3600
    },
    {
      "do": "retrieve",
      "query": "when must a controller report a breach",
      "filters": {
        "jurisdiction": "ng"
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/changes",
            "params": {
              "resume_token": "r1.start"
            }
          },
          "response": {
            "error": "connect"
          },
          "repeat": 3
        },
        {
          "request": {
            "method": "GET",
            "path": "/retrieve",
            "params": {
              "q": "when must a controller report a breach"
            }
          },
          "response": {
            "status": 502
          },
          "repeat": 3
        }
      ],
      "expect": {
        "answer": {
          "from_cache": true,
          "checked": false,
          "offline": true,
          "evidence": [
            "anc-sda-1-s40",
            "anc-sdr-1-r12"
          ],
          "labels": "currentness_not_checked",
          "cached_at": "2026-10-19T09:00:00+00:00"
        }
      }
    },
    {
      "do": "retrieve",
      "query": "what must a breach report name",
      "filters": {
        "jurisdiction": "ng"
      },
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/changes",
            "params": {
              "resume_token": "r1.start"
            }
          },
          "response": {
            "error": "timeout"
          },
          "repeat": 3
        },
        {
          "request": {
            "method": "GET",
            "path": "/retrieve"
          },
          "response": {
            "error": "timeout"
          },
          "repeat": 3
        }
      ],
      "expect": {
        "raises": "Unavailable"
      }
    },
    {
      "do": "check",
      "items": [
        {
          "anchor_id": "anc-sda-1-s40",
          "span_hash": "0f9bf5fdfd86d6f60f3a5527bcaff7066dcb0e40604986268353bd95bcc312ce"
        }
      ],
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "path": "/currentness"
          },
          "response": {
            "error": "connect"
          },
          "repeat": 3
        }
      ],
      "expect": {
        "raises": "Unavailable"
      }
    }
  ]
}
